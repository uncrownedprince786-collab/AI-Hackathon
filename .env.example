# Public site URL. Used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://ai-hackathons-tawny.vercel.app

# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# GitHub Actions sends the same value (repo secret CRON_SECRET).
CRON_SECRET=

# Site URL the GitHub Actions workflow calls (repo secret or variable SITE_URL).
SITE_URL=https://ai-hackathons-tawny.vercel.app

# Supabase (optional). Without it the dataset is read from src/data/hackathons.json.
# Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Blog article generation (no key needed — template-based, uses the dataset).
BLOG_LOCALE=en

# Local collection tuning (scripts/refresh.ts).
REFRESH_PAGES=4
REFRESH_DETAIL_LIMIT=120
REFRESH_LABLAB=1
REFRESH_FORCE=0
